{
  "apiVersion": 1,
  "id": "workbenchdemo",
  "name": "Workbench example",
  "description": "Declarative forms, an isolated page and character-scoped preferences",
  "version": "0.1.0",
  "dependencies": [],
  "permissions": ["ui.contribute", "workbenchdemo.read", "workbenchdemo.write"],
  "settings": [],
  "command": "node",
  "args": ["extension.mjs"],
  "pages": [
    { "id": "workbenchdemo.notes", "title": "Example notes", "placement": "workspace",
      "view": { "type": "form", "load": "workbenchdemo.read", "save": "workbenchdemo.save",
        "fields": [{ "key": "message", "label": "Message", "type": "textarea" }, { "key": "count", "label": "Count", "type": "number", "min": 0 }] } },
    { "id": "workbenchdemo.dashboard", "title": "Example dashboard", "placement": "workspace", "section": "knowledge",
      "view": { "type": "webview", "entry": "dashboard.html", "operations": ["workbenchdemo.read", "workbenchdemo.save"] } },
    { "id": "workbenchdemo.character", "title": "Character preferences", "placement": "character",
      "view": { "type": "form", "load": "workbenchdemo.read", "save": "workbenchdemo.save", "personaField": "personaId",
        "fields": [{ "key": "message", "label": "Message", "type": "textarea" }] } }
  ]
}
