{
  "id": "memory",
  "name": "Companion Memory",
  "description": "统一检索词构造、关键词或本地/API 语义检索，按有效上下文去重。",
  "version": "0.12.1",
  "dependencies": [
    "persona",
    "knowledge"
  ],
  "permissions": [
    "context.contribute",
    "memory.read",
    "memory.write",
    "memory.enhance",
    "inference.contribute",
    "character.contribute",
    "knowledge.read",
    "knowledge.enhance",
    "approvals.request",
    "approvals.contribute",
    "ui.contribute"
  ],
  "characterPermissions": [
    "memory.read",
    "memory.write"
  ],
  "settings": [],
  "views": [
    "memory"
  ],
  "apiVersion": 1,
  "package": "@echo/memory",
  "characterSettings": {
    "section": "memory",
    "title": "记忆与资料",
    "order": 10
  },
  "category": "Memory and behavior",
  "optionalDependencies": [
    "approvals"
  ],
  "pages": [
    {
      "id": "memory.library",
      "title": "伙伴记忆",
      "placement": "workspace",
      "section": "knowledge",
      "order": 20,
      "view": {
        "type": "catalog",
        "load": "memory.browse",
        "columns": [
          {
            "key": "title",
            "label": "标题"
          },
          {
            "key": "category",
            "label": "类别",
            "localized": true
          },
          {
            "key": "tags",
            "label": "标签"
          },
          {
            "key": "text",
            "label": "内容"
          }
        ],
        "scopeLabel": "伙伴"
      }
    }
  ]
}
