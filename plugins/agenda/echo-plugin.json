    {
      "key": "conversationId",
      "label": "Default reminder conversation ID (optional)",
      "type": "text",
      "resource": "conversation"
    }
  ],
  "views": [
    "agenda"
  ],
  "apiVersion": 1,
  "package": "@echo/agenda",
  "characterSettings": {
    "section": "tools",
    "title": "工具与委派",
    "order": 30
  },
  "category": "Tasks and execution"
}
