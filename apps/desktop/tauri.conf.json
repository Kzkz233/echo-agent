{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Echo Agent",
  "version": "0.18.9",
  "identifier": "app.echo.workbench",
  "build": {
    "beforeDevCommand": "pnpm --dir ../.. run build",
    "frontendDist": "../../dist/web"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://127.0.0.1:*; media-src 'self' http://127.0.0.1:*; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; frame-src 'self' http://127.0.0.1:*; frame-ancestors 'none'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "../../dist/runtime/": "runtime/",
      "../../dist/echo-agent.cmd": "echo-agent.cmd"
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerHooks": "../../resources/installer-hooks.nsh",
        "compression": "zlib"
      }
    }
  }
}
