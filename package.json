{
  "name": "echo-agent",
  "version": "0.18.7",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "tsx apps/server/main.ts",
    "web": "vite --config apps/workbench/vite.config.ts",
    "build": "tsx scripts/build.ts",
    "start": "node dist/server.mjs",
    "check": "tsc --noEmit && node scripts/check-locales.mjs",
    "test": "tsx --test --test-concurrency=4 --test-timeout=20000 tests/*.test.ts",
    "desktop": "cd apps/desktop && tauri dev",
    "desktop:build": "tsx scripts/build-desktop.ts",
    "verify": "pnpm run check && pnpm run test && pnpm run build",
    "release:public": "tsx scripts/release-public.ts prepare",
    "release:publish": "tsx scripts/release-public.ts publish"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^1.5.0",
    "@earendil-works/pi-ai": "^1.5.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "fflate": "^0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "undici": "^7.30.1",
    "yaml": "2.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/parser": "^8.1.0",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "optionalDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@huggingface/transformers": "^4.3.2",
    "@tencent-connect/qqbot-nodejs": "1.0.5",
    "imapflow": "^2.10.0",
    "mailparser": "^3.14.1",
    "nodemailer": "^10.3.1",
    "pdfjs-dist": "^6.5.438",
    "ws": "8.21.0"
  }
}
